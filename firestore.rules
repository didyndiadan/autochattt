rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['musicben92@gmail.com', 'weightlosstipsinside@gmail.com', 'Weightlosstipsinside@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection Health Check
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection (Strict privacy: user can only access their own profile; admins can manage)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && (
        (isOwner(userId) &&
         incoming().keys().hasAll(['email', 'name', 'role']) &&
         incoming().role in ['merchant', 'superadmin']) ||
        isAdmin()
      );
        
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
        (isAdmin() || incoming().role == existing().role);
        
      allow delete: if isAdmin();
    }

    // Admins Collection (Admin-only access)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Store Collections (Strict privacy: each merchant can ONLY view and edit their own store)
    match /stores/{storeId} {
      allow get, list: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      allow write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());

      // Products subcollection: private to merchant owner or admin
      match /products/{productId} {
        allow read, write: if isValidId(storeId) && isValidId(productId) && (isOwner(storeId) || isAdmin());
      }

      // Orders subcollection: private to merchant owner or admin, customers can create new orders
      match /orders/{orderId} {
        allow get, list: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
        
        // Customers can place new orders into the store
        allow create: if isValidId(storeId) && isValidId(orderId) &&
          incoming().keys().hasAll(['id', 'storeId', 'customerName', 'total', 'status']) &&
          incoming().storeId == storeId &&
          incoming().total is number;

        allow update, delete: if isValidId(storeId) && isValidId(orderId) && (isOwner(storeId) || isAdmin());
      }

      // Store Settings & WhatsApp Status: strictly private to merchant owner or admin
      match /settings/{settingId} {
        allow read, write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }

      // Customer Leads CRM: strictly private to merchant owner or admin
      match /leads/{leadId} {
        allow read, write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }

      // Appointments Bookings: strictly private to merchant owner or admin
      match /appointments/{appointmentId} {
        allow read, write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }
    }

    // WhatsApp Multi-Tenant Sessions: strictly private to the session user owner
    match /whatsapp_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().user_id == request.auth.uid || isAdmin());
    }
  }
}
